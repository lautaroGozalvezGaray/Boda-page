---
interface Props {
  variant: 'primary' | 'secondary';
  corner: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
}

const { variant, corner } = Astro.props;
const variantClasses = {
  primary: 'section-flourish--primary',
  secondary: 'section-flourish--secondary',
} satisfies Record<Props['variant'], string>;
const cornerClasses = {
  'top-left': 'section-flourish--top-left',
  'top-right': 'section-flourish--top-right',
  'bottom-left': 'section-flourish--bottom-left',
  'bottom-right': 'section-flourish--bottom-right',
} satisfies Record<Props['corner'], string>;
---

