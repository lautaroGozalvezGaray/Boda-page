---
import { formatLongDate } from '@/utils/formatDate';
import SectionDecorations from '@/components/SectionDecorations.astro';
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  eventDateISO: string;
  eventTimeTitle: string;
  eventTimeLabel: string;
}

const { eventDateISO, eventTimeTitle, eventTimeLabel } = Astro.props;
const dateLabel = formatLongDate(eventDateISO);
---

<section
  class="section-decorated reveal bg-sand-50/60 px-6 py-20 sm:py-28"
  aria-labelledby="evento-titulo"
>
  <SectionDecorations corner="top-left" />
  <div class="relative z-10 mx-auto flex max-w-xl flex-col items-center gap-10 text-center">
    <SectionHeading id="evento-titulo" title="El evento" />

    <dl class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5">
      <div class="card-surface-hover flex flex-col items-center gap-2 p-6 sm:p-7">
        <dt class="card-label">Fecha</dt>
        <dd class="card-value">{dateLabel}</dd>
      </div>
      <div class="card-surface-hover flex flex-col items-center gap-2 p-6 sm:p-7">
        <dt class="card-label">{eventTimeTitle}</dt>
        <dd class="card-value">{eventTimeLabel}</dd>
      </div>
    </dl>
  </div>
</section>
