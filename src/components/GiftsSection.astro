---
import CopyButton from '@/components/CopyButton';
import SectionDecorations from '@/components/SectionDecorations.astro';
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  message: string;
  bank: string;
  accountHolder: string;
  alias: string;
  cbu: string;
  surface?: 'white' | 'sand';
}

const { message, bank, accountHolder, alias, cbu, surface = 'white' } = Astro.props;
const paragraphs = message.split('\n\n');
const surfaceClass = surface === 'sand' ? 'bg-sand-50/60' : 'bg-white';
---

<section
  class:list={['section-decorated', 'reveal', surfaceClass, 'px-6 py-24 sm:py-32']}
  aria-labelledby="regalos-titulo"
>
  <SectionDecorations corner="top-left" />
  <div class="relative z-10 mx-auto flex max-w-md flex-col items-center gap-8 text-center">
    <div class="flex flex-col items-center gap-4">
      <SectionHeading id="regalos-titulo" title="Regalos" />
      <div class="flex max-w-md flex-col gap-3">
        {
          paragraphs.map((paragraph) => (
            <p class="text-base leading-relaxed text-ink-500">{paragraph}</p>
          ))
        }
      </div>
    </div>

    <div class="card-surface flex w-full flex-col gap-7 p-6 text-left sm:p-8">
      <h3 class="text-center font-serif text-2xl text-ink-800">Datos para transferencia</h3>

      <div class="flex flex-col items-center gap-2 rounded-xl border border-blush-100 bg-blush-50 p-5 text-center">
        <span class="card-label">Alias</span>
        <span class="card-value break-all text-2xl sm:text-3xl">{alias}</span>
      </div>
      <CopyButton
        client:visible
        textToCopy={alias}
        label="Copiar alias"
        successMessage="Alias copiado"
        variant="ghost"
      />

      <dl class="data-list grid grid-cols-1 gap-3 text-left sm:gap-4">
        <div class="flex min-w-0 flex-col gap-1.5 rounded-xl border border-sand-100 bg-sand-50/50 p-4">
          <dt class="card-label">Banco</dt>
          <dd class="card-value-detail">{bank}</dd>
        </div>
        <div class="flex min-w-0 flex-col gap-1.5 rounded-xl border border-sand-100 bg-sand-50/50 p-4">
          <dt class="card-label">Titular</dt>
          <dd class="card-value-detail break-words">{accountHolder}</dd>
        </div>
      </dl>

      <div class="data-cbu flex flex-col gap-3 rounded-xl border border-sand-100 bg-sand-50/50 p-4">
        <span class="card-label">CBU</span>
        <span class="break-all font-mono text-base font-medium tracking-wide text-ink-800">{cbu}</span>
        <CopyButton
          client:visible
          textToCopy={cbu}
          label="Copiar CBU"
          successMessage="CBU copiado"
          variant="ghost"
        />
      </div>
    </div>
  </div>
</section>
