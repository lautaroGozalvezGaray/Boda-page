---
import CopyButton from '@/components/CopyButton';

interface Props {
  message: string;
  bank: string;
  accountHolder: string;
  alias: string;
  cbu: string;
  surface?: 'white' | 'sand';
}

const { message, bank, accountHolder, alias, cbu, surface = 'white' } = Astro.props;
const paragraphs = message.split('\n\n');
const surfaceClass = surface === 'sand' ? 'bg-sand-50/60' : 'bg-white';
---

<section class:list={['reveal', surfaceClass, 'px-6 py-24 sm:py-32']} aria-labelledby="regalos-titulo">
  <div class="mx-auto flex max-w-md flex-col items-center gap-8 text-center">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      class="h-8 w-8 text-blush-300"
      aria-hidden="true"
    >
      <rect x="3" y="8" width="18" height="13" rx="1.5"></rect>
      <path d="M3 12h18"></path>
      <path d="M12 8v13"></path>
      <path d="M12 8c-1.5-3.5-6-3.5-6-1 0 1.4 1.8 1 6 1Z"></path>
      <path d="M12 8c1.5-3.5 6-3.5 6-1 0 1.4-1.8 1-6 1Z"></path>
    </svg>

    <div class="flex flex-col items-center gap-3">
      <h2 id="regalos-titulo" class="font-accent text-4xl italic text-ink-800 sm:text-5xl">
        Regalos
      </h2>
      <div class="flex flex-col gap-3">
        {paragraphs.map((paragraph) => (
          <p class="text-base leading-relaxed text-ink-500">{paragraph}</p>
        ))}
      </div>
    </div>

    <div class="flex w-full flex-col items-center gap-6 pt-2">
      <div class="flex flex-col items-center gap-1">
        <span class="section-eyebrow">Alias</span>
        <span class="break-all font-serif text-3xl text-ink-800">{alias}</span>
      </div>
      <CopyButton
        client:visible
        textToCopy={alias}
        label="Copiar alias"
        successMessage="Alias copiado"
        variant="ghost"
      />

      <span class="h-px w-10 bg-sand-200" aria-hidden="true"></span>

      <div class="flex flex-col items-center gap-1">
        <span class="section-eyebrow">CBU</span>
        <span class="break-all font-mono text-xs text-ink-500">{cbu}</span>
      </div>
      <CopyButton
        client:visible
        textToCopy={cbu}
        label="Copiar CBU"
        successMessage="CBU copiado"
        variant="ghost"
      />

      <div class="flex flex-col items-center gap-0.5 pt-3 text-xs text-ink-400">
        <span>{bank}</span>
        <span>{accountHolder}</span>
      </div>
    </div>
  </div>
</section>
