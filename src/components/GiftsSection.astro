---
import CopyButton from '@/components/CopyButton';
import SectionDecorations from '@/components/SectionDecorations.astro';
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  message: string;
  bank: string;
  accountHolder: string;
  alias: string;
  cbu: string;
  surface?: 'white' | 'sand';
}

const { message, bank, accountHolder, alias, cbu, surface = 'white' } = Astro.props;
const paragraphs = message.split('\n\n');
const surfaceClass = surface === 'sand' ? 'bg-sand-50/60' : 'bg-white';
---

<section
  class:list={['section-decorated', 'reveal', surfaceClass, 'px-6 py-24 sm:py-32']}
  aria-labelledby="regalos-titulo"
>
  <SectionDecorations corner="top-left" />
  <div class="relative z-10 mx-auto flex max-w-md flex-col items-center gap-8 text-center">
    <div class="flex flex-col items-center gap-4">
      <SectionHeading id="regalos-titulo" title="Regalos" />
      <div class="flex max-w-md flex-col gap-3">
        {
          paragraphs.map((paragraph) => (
            <p class="text-base leading-relaxed text-ink-500">{paragraph}</p>
          ))
        }
      </div>
    </div>

    <div class="card-surface flex w-full flex-col gap-6 p-6 text-left sm:p-8">
      <h3 class="text-center font-serif text-xl text-ink-800">Datos para transferencia</h3>

      <div class="flex flex-col items-center gap-1 rounded-xl bg-blush-50/70 p-4 text-center">
        <span class="section-eyebrow">Alias</span>
        <span class="break-all font-serif text-2xl text-ink-800">{alias}</span>
      </div>
      <CopyButton
        client:visible
        textToCopy={alias}
        label="Copiar alias"
        successMessage="Alias copiado"
        variant="ghost"
      />

      <dl class="grid grid-cols-1 gap-4 text-left sm:grid-cols-2">
        <div class="flex flex-col gap-1">
          <dt class="section-eyebrow">Banco</dt>
          <dd class="text-sm text-ink-800">{bank}</dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="section-eyebrow">Titular</dt>
          <dd class="text-sm text-ink-800">{accountHolder}</dd>
        </div>
      </dl>

      <div class="flex flex-col gap-2">
        <span class="section-eyebrow">CBU</span>
        <span class="break-all font-mono text-sm text-ink-800">{cbu}</span>
        <CopyButton
          client:visible
          textToCopy={cbu}
          label="Copiar CBU"
          successMessage="CBU copiado"
          variant="ghost"
        />
      </div>
    </div>
  </div>
</section>
