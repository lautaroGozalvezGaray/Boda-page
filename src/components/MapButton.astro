---
import { buildGoogleMapsPlaceUrl } from '@/utils/links';

interface Props {
  destination: string;
}

const { destination } = Astro.props;
const mapsUrl = buildGoogleMapsPlaceUrl(destination);
---

<a
  href={mapsUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-map-destination={destination}
  class="btn-secondary px-6 py-3"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    class="h-4 w-4"
    aria-hidden="true"
  >
    <path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 1 1 18 0Z"></path>
    <circle cx="12" cy="10" r="3"></circle>
  </svg>
  Cómo llegar
</a>

<script>
  import { buildAppleMapsPlaceUrl, isAppleMobileDevice } from '@/utils/links';

  document.querySelectorAll<HTMLAnchorElement>('[data-map-destination]').forEach((link) => {
    link.addEventListener('click', () => {
      const destination = link.dataset.mapDestination;

      if (destination && isAppleMobileDevice(navigator.userAgent, navigator.maxTouchPoints)) {
        link.href = buildAppleMapsPlaceUrl(destination);
      }
    });
  });
</script>
