---
import type { EntryType, PricingPeriod } from '@/config/wedding';
import PricingTable from '@/components/PricingTable';
import SectionDecorations from '@/components/SectionDecorations.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getCurrentPeriodIndex } from '@/utils/pricingPeriod';

interface Props {
  entryType: EntryType;
  pricingPeriods: PricingPeriod[];
}

const { entryType, pricingPeriods } = Astro.props;
const initialCurrentIndex = getCurrentPeriodIndex(pricingPeriods);
---

<section
  class="section-decorated reveal bg-white px-6 py-20 sm:py-28"
  aria-labelledby="pago-titulo"
>
  <SectionDecorations corner="bottom-right" />
  <div class="relative z-10 mx-auto flex max-w-2xl flex-col items-center gap-8 text-center">
    <div class="flex flex-col items-center gap-3">
      <SectionHeading id="pago-titulo" title="Valor de la tarjeta" />
      <p class="max-w-md text-base leading-relaxed text-ink-600">
        Según cuándo reserves tu lugar en nuestra boda, estos serán los valores.
      </p>
    </div>

    <PricingTable
      client:load
      periods={pricingPeriods}
      entryType={entryType}
      initialCurrentIndex={initialCurrentIndex}
    />

    <p class="-mt-2 max-w-md rounded-xl border border-blush-200 bg-white px-5 py-3 text-sm font-semibold leading-relaxed text-blush-800 shadow-[0_4px_12px_rgba(167,95,73,0.1)] sm:text-base">
      Menores abonan el 50% del valor de la tarjeta.
    </p>

    <p class="-mt-2 max-w-md rounded-xl border border-blush-200 bg-white px-5 py-3 text-sm font-semibold leading-relaxed text-blush-800 shadow-[0_4px_12px_rgba(167,95,73,0.1)] sm:text-base">
      Tenés tiempo para abonar la tarjeta hasta el 5 de febrero.
    </p>

  </div>
</section>
