---
import type { EntryType, PricingPeriod } from '@/config/wedding';
import PricingTable from '@/components/PricingTable';
import CopyButton from '@/components/CopyButton';
import SectionDecorations from '@/components/SectionDecorations.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getCurrentPeriodIndex } from '@/utils/pricingPeriod';

interface Props {
  entryType: EntryType;
  pricingPeriods: PricingPeriod[];
  bank: string;
  accountHolder: string;
  cuit: string;
  alias: string;
  cbu: string;
  accountNumber: string;
}

const { entryType, pricingPeriods, bank, accountHolder, cuit, alias, cbu, accountNumber } =
  Astro.props;
const initialCurrentIndex = getCurrentPeriodIndex(pricingPeriods);
---

<section
  class="section-decorated reveal bg-sand-50/60 px-6 py-20 sm:py-28"
  aria-labelledby="pago-titulo"
>
  <SectionDecorations corner="top-right" />
  <div class="relative z-10 mx-auto flex max-w-2xl flex-col items-center gap-8 text-center">
    <div class="flex flex-col items-center gap-3">
      <SectionHeading id="pago-titulo" title="Valores de la entrada" />
      <p class="max-w-md text-base leading-relaxed text-ink-600">
        Los valores varían según la fecha de pago. A continuación se destaca el valor vigente.
      </p>
    </div>

    <PricingTable
      client:load
      periods={pricingPeriods}
      entryType={entryType}
      initialCurrentIndex={initialCurrentIndex}
    />

    <div class="card-surface flex w-full flex-col gap-7 p-6 sm:p-8">
      <h3 class="font-serif text-xl text-ink-800">Información para realizar la transferencia</h3>

      <div class="flex flex-col items-center gap-2 rounded-xl border border-blush-100 bg-blush-50 p-5">
        <span class="card-label">Alias</span>
        <span class="card-value break-all text-2xl sm:text-3xl">{alias}</span>
      </div>
      <CopyButton
        client:visible
        textToCopy={alias}
        label="Copiar alias"
        successMessage="Alias copiado."
      />

      <dl class="data-list grid grid-cols-1 gap-3 text-left sm:grid-cols-2 sm:gap-4">
        <div class="flex flex-col gap-1">
          <dt class="section-eyebrow">Banco</dt>
          <dd class="text-sm text-ink-800">{bank}</dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="section-eyebrow">Titular</dt>
          <dd class="text-sm text-ink-800">{accountHolder}</dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="section-eyebrow">CUIT/CUIL</dt>
          <dd class="text-sm text-ink-800">{cuit}</dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="section-eyebrow">Número de cuenta</dt>
          <dd class="break-all text-sm text-ink-800">{accountNumber}</dd>
        </div>
      </dl>

      <div class="data-cbu flex flex-col gap-3">
        <span class="section-eyebrow">CBU</span>
        <span class="break-all font-mono text-sm text-ink-800">{cbu}</span>
        <CopyButton
          client:visible
          textToCopy={cbu}
          label="Copiar CBU"
          successMessage="CBU copiado."
        />
      </div>
    </div>
  </div>
</section>
