---
import BotanicalFlourish from '@/components/BotanicalFlourish.astro';

interface Props {
  corner: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  divider?: boolean;
}

const { corner, divider = true } = Astro.props;
const activeEdge = corner.startsWith('top') ? 'top' : 'bottom';
const oppositeEdge = activeEdge === 'top' ? 'bottom' : 'top';
const cornersByEdge = {
  top: ['top-left', 'top-right'],
  bottom: ['bottom-left', 'bottom-right'],
} as const satisfies Record<'top' | 'bottom', readonly Props['corner'][]>;
---

{cornersByEdge[activeEdge].map((flourishCorner) => (
  <BotanicalFlourish variant="primary" corner={flourishCorner} />
))}

{cornersByEdge[oppositeEdge].map((flourishCorner) => (
  <BotanicalFlourish variant="secondary" corner={flourishCorner} />
))}

{
  divider && (
    <div class="section-divider" aria-hidden="true">
      <span />
      <svg viewBox="0 0 12 12" fill="none">
        <path d="m6 1.5 2 4.5-2 4.5L4 6l2-4.5Z" stroke="currentColor" />
      </svg>
      <span />
    </div>
  )
}
