---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Invitación no encontrada"
  description="El enlace de invitación que intentaste abrir no existe o ya no está disponible."
>
  <main
    class="flex min-h-[100svh] flex-col items-center justify-center gap-6 bg-gradient-to-b from-sand-100 via-sand-50 to-blush-50 px-6 text-center"
  >
    <p class="text-sm uppercase tracking-[0.35em] text-blush-600">Ups</p>
    <h1 class="font-serif text-3xl text-ink-800 sm:text-4xl">Invitación no encontrada</h1>
    <p class="max-w-md text-base text-ink-600">
      El enlace que abriste no corresponde a ninguna invitación válida. Revisá que la dirección esté
      completa o contactá a los novios.
    </p>
    <a
      href="/"
      class="inline-flex min-h-11 items-center justify-center rounded-full border border-blush-400 bg-white/70 px-8 py-3 text-sm font-medium text-blush-700 shadow-sm transition-colors hover:bg-blush-500 hover:text-white"
    >
      Volver al inicio
    </a>
  </main>
</Layout>
