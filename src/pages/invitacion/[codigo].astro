---
import Layout from '@/layouts/Layout.astro';
import Cover from '@/components/Cover.astro';
import Countdown from '@/components/Countdown';
import EventDetails from '@/components/EventDetails.astro';
import LocationSection from '@/components/LocationSection.astro';
import DressCode from '@/components/DressCode.astro';
import PaymentSection from '@/components/PaymentSection.astro';
import TransferSection from '@/components/TransferSection.astro';
import GiftsSection from '@/components/GiftsSection.astro';
import InvitationFooter from '@/components/InvitationFooter.astro';
import RsvpForm from '@/components/RsvpForm';
import ScrollHint from '@/components/ScrollHint';
import MusicPlayer from '@/components/MusicPlayer';
import ScrollReveal from '@/components/ScrollReveal.astro';
import SectionDecorations from '@/components/SectionDecorations.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getAllVariantCodes, getVariantByCode, weddingConfig } from '@/config/wedding';

export function getStaticPaths() {
  return getAllVariantCodes().map((codigo) => ({ params: { codigo } }));
}

const { codigo } = Astro.params;
const variant = codigo ? getVariantByCode(codigo) : undefined;

if (!variant) {
  return Astro.redirect('/404');
}

const {
  coupleNames,
  eventDateISO,
  eventTimeTitle,
  eventTimeLabel,
  venue,
  whatsapp,
  payment,
  gifts,
  dressCode,
  cover,
  seo,
} = weddingConfig;
const rsvpSurfaceClass = variant.showPayment ? 'bg-sand-50/60' : 'bg-white';
---

<Layout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
  <main>
    <Cover
      kicker={cover.kicker}
      partnerOne={coupleNames.partnerOne}
      partnerTwo={coupleNames.partnerTwo}
      eventDateISO={eventDateISO}
      ctaLabel={cover.ctaLabel}
      ctaTargetId="detalle"
    />
    <ScrollHint client:load targetId="detalle" />
    <MusicPlayer client:load />

    <div id="detalle">
      <section
        class="section-decorated reveal bg-white px-6 py-20 sm:py-28"
        aria-labelledby="cuenta-regresiva-titulo"
      >
        <SectionDecorations corner="bottom-left" />
        <div class="relative z-10 mx-auto flex max-w-xl flex-col items-center gap-8 text-center">
          <SectionHeading id="cuenta-regresiva-titulo" title="Cuenta regresiva" />
          <Countdown client:load targetISO={eventDateISO} />
        </div>
      </section>

      <EventDetails
        eventDateISO={eventDateISO}
        eventTimeTitle={eventTimeTitle}
        eventTimeLabel={eventTimeLabel}
      />

      <LocationSection
        venueName={venue.name}
        address={venue.address}
        destination={venue.mapsDestination}
        calendarTitle={`Boda de ${coupleNames.partnerOne} y ${coupleNames.partnerTwo}`}
        calendarDescription="Nos encantaría contar con tu presencia."
        calendarLocation={`${venue.name}, ${venue.city}`}
        eventDateISO={eventDateISO}
      />

      <DressCode title={dressCode.title} description={dressCode.description} />

      {
        variant.showPayment && variant.entryType && (
          <PaymentSection
            entryType={variant.entryType}
            pricingPeriods={payment.pricingPeriods}
          />
        )
      }

      <section
        class:list={[
          'section-decorated reveal flex flex-col items-center gap-8 px-6 py-20 pb-24 text-center sm:py-28',
          rsvpSurfaceClass,
        ]}
        aria-labelledby="rsvp-titulo"
      >
        <SectionDecorations corner={variant.showPayment ? 'top-left' : 'bottom-left'} />
        <div class="relative z-10 flex flex-col items-center gap-3">
          <SectionHeading id="rsvp-titulo" title="Te esperamos" />
          <p class="max-w-md text-base text-ink-600">
            Completá el formulario para confirmar tu asistencia. Te vamos a redirigir a WhatsApp con
            el mensaje ya armado.
          </p>
        </div>
        <div class="relative z-10">
          <RsvpForm
            client:visible
            phoneNumber={whatsapp.phoneNumber}
            partnerOne={coupleNames.partnerOne}
            partnerTwo={coupleNames.partnerTwo}
            referenceCode={variant.code}
            showTransferNotice={variant.showPayment}
          />
        </div>
      </section>

      {
        variant.showPayment && (
          <TransferSection
            bank={payment.bank}
            accountHolder={payment.accountHolder}
            cuit={payment.cuit}
            alias={payment.alias}
            cbu={payment.cbu}
            accountNumber={payment.accountNumber}
          />
        )
      }

      <GiftsSection
        message={gifts.message}
        bank={payment.bank}
        accountHolder={payment.accountHolder}
        alias={payment.alias}
        cbu={payment.cbu}
        surface="sand"
      />
      <InvitationFooter partnerOne={coupleNames.partnerOne} partnerTwo={coupleNames.partnerTwo} />
    </div>
  </main>

  <ScrollReveal />
</Layout>
